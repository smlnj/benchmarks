#========== The 'plot' command ==========
#
from datadraw import DataDraw, write_svgfile

# generate an SVG plot
#
# NOTE: for now we just plot the average per-program real-time numbers
#
def plot(dd, data):
  # get the list of program names in the data set
  #
  progs = [ p['program'] for p in data['data'] ]

  # get the range of times
  #
  times = [ compute_stats([sample['real'] for sample in p['run-times']])
    for p in data['data'] ]
  # get the range of times
  #
  t_min = 0
  t_max = 0
  for t in times:
    t_max = max(t_max, t['mean'])

  # compute the width based on the number of programs
  #
  left_margin = 50
  right_margin = 30
  top_margin = 10
  bottom_margin = 90
  width = len(progs) * 25 + left_margin + right_margin
  height = 250 + top_margin + bottom_margin
  dd.svgbegin(width, height)

  # the X axis corresponds to the programs
  #
  dd.setspace('X', svgrange=(left_margin, width-right_margin), categorical=dd.catinfo(progs))

  # the Y axis is the timing data
  #
  dd.setspace('Y', svgrange=(bottom_margin, height-top_margin), datarange=(t_min, t_max))

  # render the axes
  #
  dd.axis('X', tics=-8, stubrotate=40)
  dd.axis('Y', axisline=False, grid=True)
  dd.plotlabels(xlabel="Programs", xlabelpos=-80, ylabel="Time (s)", ylabelpos=-25)

  # plot data values
  #
  for p, t in zip(progs, times):
    dd.bar(p, t['mean'], width=12, color='#8a8')

  dd.rect(color=None, outline=True, x1=0, y1=0, x2=width, y2=height)

  return dd.svgresult()

def do_plot():
  dd = DataDraw()

  for f in cmdln_args.files:
    data = load_result_file(f)
    write_svgfile(plot(dd, data), f"{f.removesuffix('.json')}.svg")

#========== The 'merge' command ==========
#

# merge the data for a program info an existing data object.
#
def merge_program_data(acc_obj, obj):
  return

def do_merge():
  # load the files to merge
  #
  data_files = []
  for f in cmdln_args.files:
    data = load_result_file(f)
    data['filename'] = f
    data_files.append(data)

  if len(data_files) < 2:
    error("merge command requires at least two files")

  hdr_keys = [
      'machine', 'sml-command', 'sml-system', 'sml-version', 'sml-options',
      'single-file', 'include-basis', 'alloc'
    ]

  # we need to check the compatibility of the data files.  We require that
  # the header information (machine, sml-command, sml-system, etc.) be the
  # same for all of the files.
  modes = set(data_files[0]['modes'])
  for i in range(1, len(data_files)):
    data = data_files[i]
    modes.union(set(data['modes']))
    for key in hdr_keys:
       if (data_files[0].get(key, None) != data.get(key, None)):
          error(f"merge command: input files differ on '{key}' field")

  # check the `modes`
  #
# TODO: once the `stats` command is implemented, we could recompute the statistics
# after the merge
  if ('run-times-w-stats' in modes or 'compile-times-w-stats' in modes):
    error("merge: unable to merge files with statistics")

  # set up a dictionary to hold the result of the merging
  #
  merged = {
      'date' : data_files[0]['date'],
      'machine' : data_files[0]['machine'],
      'sml-command' : data_files[0]['sml-command'],
      'sml-system' : data_files[0]['sml-system'],
      'sml-version' : data_files[0]['sml-version'],
      'sml-options' : data_files[0]['sml-options'],
      'single-file' : data_files[0]['single-file'],
      'include-basis' : data_files[0]['include-basis'],
      'modes' : list(modes),
      'alloc' : data_files[0]['alloc']
    }

  # merge the data from the files
  #
  progs = {}
  for data in data_files:
    for d in data['data']:
      p = d['program']
      if p in progs:
        # need to merge `d` into `progs[p]`
        merge_program_data(progs[p], d)
      else:
        progs[p] = d

  # add the merged program data to the `merged` dictionary
  #
  for p in prog_info.programs():
    if p in progs:
      merged[p] = progs[p]

  dump_json(merged)


#========== The 'compare' command ==========
#
def do_compare():
  return

#========== Main program ==========
#

# set up the command-line option parsing
#
create_arg_parser().parse_args(namespace=cmdln_args)

if (cmdln_args.cmd == 'stats'):
  do_stats()
elif (cmdln_args.cmd == "plot"):
  do_plot()
elif (cmdln_args.cmd == "merge"):
  do_merge()
elif (cmdln_args.cmd == "compare"):
  do_compare()
else:
  error("unrecognized command")
